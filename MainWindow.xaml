<Window x:Class="DnsEquipmentLedger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DnsEquipmentLedger.ViewModels"
        Title="Электронная книга учёта техники «ДНС»" 
        Height="620" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FC8507" CornerRadius="8" Padding="18,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ДНС — ЭЛЕКТРОННАЯ КНИГА УЧЁТА ТЕХНИКИ ФИЛИАЛА" 
                           Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Реестр оборудования, материально ответственных лиц и локаций (WPF • MVVM • EF Core • 3НФ)" 
                           Foreground="#FFF3E0" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                BorderBrush="#E0E4E8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Поиск (Инв. номер, модель, серийный номер или ФИО МОЛ):" 
                               FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Категория оборудования:" 
                               FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Сбросить фильтр" 
                        Command="{Binding ResetFilterCommand}"
                        Height="30" Padding="14,0" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        Background="#EAECEF" BorderThickness="0" Cursor="Hand"/>

                <Button Grid.Column="3" Content="Обновить БД" 
                        Command="{Binding RefreshCommand}"
                        Height="30" Padding="14,0" VerticalAlignment="Bottom"
                        Background="#FC8507" Foreground="White" FontWeight="SemiBold" 
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Таблица учёта единиц техники -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding FilteredEquipment}"
                  SelectedItem="{Binding SelectedEquipment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  RowHeight="34"
                  FontSize="13"
                  Background="White"
                  BorderBrush="#E0E4E8"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F0F0F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="145" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Наименование модели" Binding="{Binding ModelName}" Width="*"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding Manufacturer.Name}" Width="110"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="180"/>
                <DataGridTextColumn Header="Локация (Отдел)" Binding="{Binding Location.Name}" Width="170"/>
                <DataGridTextColumn Header="Ответственный (МОЛ)" Binding="{Binding ResponsibleEmployee.FullName}" Width="180"/>
                <DataGridTextColumn Header="Стоимость (₽)" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя строка состояния -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding FilteredEquipment.Count, StringFormat=Отображено единиц техники на учёте: {0}}" 
                   Margin="4,10,0,0" Foreground="#555" FontSize="12" FontWeight="SemiBold"/>
    </Grid>
</Window>